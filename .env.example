# =====================================================================
# LifeMap AI - Environment Variables Reference (.env.example)
# =====================================================================

# --- ML Service (Render: lifemap-ai-hbmn) ---
# Primary Google Gemini API key for OCR extraction & clinical pipeline
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini model (Gemini 1.5 retired -> use gemini-2.5-flash-lite)
METABOLIC_LLM_MODEL=gemini-2.5-flash-lite

# Optional: Groq API key for ultra-fast, generous rate limit LLM fallback (llama-3.1-8b-instant)
GROQ_API_KEY=your_groq_api_key_here

# Optional: OpenAI API key fallback
OPENAI_API_KEY=

# --- Express Backend (Render: lifemap-backend-qbei) ---
# ML Microservice URL (no localhost fallback in production)
FASTAPI_URL=https://lifemap-ai-hbmn.onrender.com

# Backend listening port
PORT=5000

# Optional PostgreSQL Database URL (falls back to local JSON store if omitted)
DATABASE_URL=

# JWT Secret for authentication tokens
JWT_SECRET=your_jwt_secret_key_here

# --- Frontend (Vercel) ---
# Express Backend API URL (configured in Vercel Production & Preview settings)
NEXT_PUBLIC_API_URL=https://lifemap-backend-qbei.onrender.com
