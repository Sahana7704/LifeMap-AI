# =====================================================================
# LifeMap AI Backend - Environment Variables Reference (.env.example)
# =====================================================================

# Server Port
PORT=5000

# ML Microservice URL (FastAPI)
FASTAPI_URL=http://127.0.0.1:8000

# Diabetes Microservice URL (FastAPI)
DIABETES_SERVICE_URL=http://127.0.0.1:8005

# Optional Database Connection String (PostgreSQL)
DATABASE_URL=

# JWT Secret Key for Authentication
JWT_SECRET=your_jwt_secret_key_here
